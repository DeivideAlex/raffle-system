# Mercado Pago - Credenciais (substitua pelos valores reais)
# Para produção: use as chaves que começam com APP_USR-
# Para teste: use as chaves que começam com TEST-

MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN_AQUI
MERCADO_PAGO_PUBLIC_KEY=APP_USR-SEU_PUBLIC_KEY_AQUI

# Variável exposta ao frontend via Vite (deve ter prefixo VITE_)
VITE_MP_PUBLIC_KEY=APP_USR-SEU_PUBLIC_KEY_AQUI
